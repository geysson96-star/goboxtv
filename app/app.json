{
  "expo": {
    "name": "GoBoxTV",
    "slug": "goboxtv",
    "scheme": "goboxtv",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goboxtv.app"
    },
    "android": {
      "package": "com.goboxtv.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "GoBoxTV",
      "backgroundColor": "#070A12"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "./plugins/withAndroidTV.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}